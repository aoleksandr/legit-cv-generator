{
  "name": "legit-cv-generator",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "dev": "pnpm --filter @cv/shared build && pnpm --parallel --filter @cv/api --filter @cv/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @cv/shared build && pnpm --filter @cv/api test",
    "typecheck": "pnpm --filter @cv/shared build && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "pnpm --filter @cv/shared build && pnpm --filter @cv/api db:seed",
    "eval": "pnpm --filter @cv/shared build && pnpm --filter @cv/api eval"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
